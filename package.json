{
  "name": "a11y-reports",
  "version": "1.0.0",
  "description": "Génère des rapports d’accessibilité numérique (RGAA) à partir de scans automatisés, au format HTML et PDF.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "bin": {
    "a11y-report": "src/cli.js"
  },
  "files": [
    "src",
    "design/tokens.json",
    "design/brandings",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "accessibilite",
    "rgaa",
    "wcag",
    "audit",
    "pdf",
    "rapport"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 test/*.test.js",
    "demo:serve": "node scripts/serve-demo.js",
    "verify:pdf": "node scripts/verify-pdf.js",
    "check:dod": "node scripts/check-dod.js",
    "lint:layout": "node scripts/layout-lint.js",
    "check:links": "node scripts/check-links.js",
    "check:site-layout": "node scripts/check-site-layout.js",
    "build:site": "node scripts/build-site-css.js",
    "build:demo": "node scripts/build-demo.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
